<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used by ops/build-mac-app.sh only when it signs with a real identity (STARHOLM_SIGN_IDENTITY), which turns on the
     hardened runtime. An ad hoc build ignores it. Python needs these two under the hardened runtime: ctypes and
     pyobjc make executable memory, and the bundled extension modules are signed by this build, not by Apple. -->
<plist version="1.0"><dict>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key><true/>
  <key>com.apple.security.cs.disable-library-validation</key><true/>
</dict></plist>
